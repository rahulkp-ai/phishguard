# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------
# Flask / Security
# -----------------------------------------------------------------------
# Generate a strong key:
#   python scripts/generate_secret_key.py
SECRET_KEY=change-me-before-deployin

# -----------------------------------------------------------------------
# Model
# -----------------------------------------------------------------------
# Absolute path to the trained model file.
# Default: <project_root>/models/phishing_model.joblib
# MODEL_PATH=/absolute/path/to/models/phishing_model.joblib

# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------
PORT=5005

# Number of gunicorn workers (production only).
# Recommended: (2 × CPU cores) + 1
# Free-tier containers (512 MB RAM): keep at 2-3
WEB_CONCURRENCY=3

# Log level: debug | info | warning | error
LOG_LEVEL=info

# -----------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------
# Used by docker-compose.yml prod service.
# SECRET_KEY above is also read by compose.

# Image tag for the prod service (override for specific versions)
# IMAGE_TAG=latest
